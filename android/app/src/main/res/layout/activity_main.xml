<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="InstaWasap"
            android:textColor="@color/ig"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descargá videos de Instagram y mandalos por WhatsApp, o hacé stickers animados."
            android:textColor="@color/sub"
            android:textSize="15sp" />

        <!-- 1. Link -->
        <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Link del reel o post">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPegar"
                        style="@style/Boton.Borde"
                        android:layout_width="0dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Pegar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDescargar"
                        style="@style/Boton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Descargar" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Preparando la app… (la primera vez tarda unos segundos)"
                    android:textColor="@color/sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Video -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVideo"
            style="@style/Tarjeta"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:background="#000000">

                    <VideoView
                        android:id="@+id/video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/sub" />

                <TextView
                    android:id="@+id/aviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/wa_oscuro"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAchicar"
                    style="@style/Boton"
                    android:text="Achicar a menos de 16 MB"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsApp"
                    style="@style/Boton.WhatsApp"
                    android:text="Mandar por WhatsApp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditar"
                    style="@style/Boton.Borde"
                    android:text="✂️ Editar gratis (CapCut, InShot…)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    style="@style/Boton.Borde"
                    android:text="Guardar en la galería" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOtraApp"
                    style="@style/Boton.Borde"
                    android:text="Compartir con otra app" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Sticker animado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSticker"
            style="@style/Tarjeta"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hacer sticker animado"
                    android:textColor="@color/texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoRecorte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:checkedButton="@+id/btnCuadrado"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCuadrado"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recortar al centro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompleto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cuadro completo" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/txtInicio"
                    style="@style/Etiqueta"
                    android:text="Desde el segundo: 0.0" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsarActual"
                    style="@style/Boton.Borde"
                    android:text="Usar el momento que estoy viendo" />

                <TextView
                    android:id="@+id/txtDur"
                    style="@style/Etiqueta"
                    android:text="Duración: 3 s (máx. 10)" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.5"
                    android:value="3"
                    android:valueFrom="1"
                    android:valueTo="10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearSticker"
                    style="@style/Boton"
                    android:text="Crear sticker animado" />

                <LinearLayout
                    android:id="@+id/resSticker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgSticker"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:background="#33888888"
                        android:contentDescription="Vista previa del sticker" />

                    <TextView
                        android:id="@+id/metaSticker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/sub" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStickerWhatsApp"
                        style="@style/Boton.WhatsApp"
                        android:text="Mandar sticker por WhatsApp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStickerGuardar"
                        style="@style/Boton.Borde"
                        android:text="Guardar sticker" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Usala solo con videos propios o con permiso del autor."
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
