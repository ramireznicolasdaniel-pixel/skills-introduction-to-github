<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VideoIA"
                android:textColor="@color/ig"
                android:textSize="28sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfig"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ Configuración" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escribí una idea y la IA de Google (Veo) te hace el video. Después lo mandás por WhatsApp o lo convertís en sticker animado."
            android:textColor="@color/sub"
            android:textSize="15sp" />

        <!-- 0. Configuración -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConfig"
            style="@style/Tarjeta"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuración"
                    android:textColor="@color/texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Etiqueta"
                    android:text="¿Con qué IA generar los videos?" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:checkedButton="@+id/btnProvGoogle"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProvGoogle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Google Veo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProvAbx"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Abracadabrax" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Abracadabrax -->
                <LinearLayout
                    android:id="@+id/seccionAbx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Usa tu cuenta de Abracadabrax (Kling, Seedance, Sora o Veo). Los videos se pagan con créditos de Abracadabrax: antes de generar, la app te muestra cuántos créditos cuesta y te pide confirmar. Registrarse es gratis."
                        android:textColor="@color/sub" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConectarAbx"
                        style="@style/Boton"
                        android:text="Conectar mi cuenta de Abracadabrax" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPanelAbx"
                        style="@style/Boton.Borde"
                        android:text="Abrir mi cuenta (créditos)" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Modelo de video">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/modeloAbx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Duración (segundos)">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/durAbx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Google Veo -->
                <LinearLayout
                    android:id="@+id/seccionGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Necesitás una clave de API de Google AI Studio con la facturación activada. Generar videos con IA cuesta plata: Google te cobra cada video (entre US$0,40 y US$3,20 por video de 8 segundos según el modelo, precios aprox. de nov. 2026). La clave se guarda solo en este celular."
                    android:textColor="@color/sub" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConseguirClave"
                    style="@style/Boton.Borde"
                    android:text="Conseguir mi clave en Google AI Studio" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Clave de API"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/clave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarClave"
                    style="@style/Boton"
                    android:text="Guardar clave y buscar modelos" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/cajaModelo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Modelo de IA">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/modelo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/estadoConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Crear -->
        <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="🎵 Escenas de Tito y Pancho (dibujito 3D)">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/escenaTito"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLetra"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver la letra de la canción" />

                <TextView
                    style="@style/Etiqueta"
                    android:text="Empezar desde" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoPartida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:checkedButton="@+id/btnSoloTexto"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSoloTexto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Texto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDesdeImagen"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Imagen" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDesdeVideo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Video" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Desde imagen -->
                <LinearLayout
                    android:id="@+id/partidaImagen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirImagen"
                        style="@style/Boton.Borde"
                        android:text="🖼 Elegir imagen" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="La IA anima tu imagen. Abajo contale qué querés que pase (opcional)."
                        android:textColor="@color/sub"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Desde video -->
                <LinearLayout
                    android:id="@+id/partidaVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirVideo"
                        style="@style/Boton.Borde"
                        android:text="🎞 Elegir video" />

                    <TextView
                        android:id="@+id/txtCuadro"
                        style="@style/Etiqueta"
                        android:text="La IA sigue desde el segundo: 0.0" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderCuadro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="1" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/chkUnir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Unir mi video (hasta ese segundo) con el que genera la IA" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgPartida"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#22888888"
                    android:contentDescription="Imagen de partida"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="¿Qué video querés? Describilo con detalle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/idea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Etiqueta"
                    android:text="Ideas para probar:" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ideas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Un perro con anteojos de sol surfeando una ola gigante al atardecer, cámara lenta" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Un astronauta bailando cumbia en la luna, con la Tierra de fondo" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Un gato chef cocinando empanadas en una cocina antigua, estilo animación 3D" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/Etiqueta"
                    android:text="Formato" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoFormato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:checkedButton="@+id/btnVertical"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVertical"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vertical (estados)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHorizontal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Horizontal" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Qué NO querés que aparezca (opcional)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noQuiero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text|textCapSentences"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/cajaEstilo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Estilo (ej: 3D animation, anime, cinematic)"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/estilo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/costo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerar"
                    style="@style/Boton"
                    android:text="✨ Generar video" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    style="@style/Boton.Borde"
                    android:text="Cancelar"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Video -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVideo"
            style="@style/Tarjeta"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:background="#000000">

                    <VideoView
                        android:id="@+id/video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/sub" />

                <TextView
                    android:id="@+id/aviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/wa_oscuro"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAchicar"
                    style="@style/Boton"
                    android:text="Achicar a menos de 16 MB"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsApp"
                    style="@style/Boton.WhatsApp"
                    android:text="Mandar por WhatsApp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditar"
                    style="@style/Boton.Borde"
                    android:text="✂️ Editar gratis (CapCut, InShot…)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    style="@style/Boton.Borde"
                    android:text="Guardar en la galería" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOtraApp"
                    style="@style/Boton.Borde"
                    android:text="Compartir con otra app" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Sticker animado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSticker"
            style="@style/Tarjeta"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hacer sticker animado"
                    android:textColor="@color/texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoRecorte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:checkedButton="@+id/btnCuadrado"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCuadrado"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recortar al centro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompleto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cuadro completo" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/txtInicio"
                    style="@style/Etiqueta"
                    android:text="Desde el segundo: 0.0" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsarActual"
                    style="@style/Boton.Borde"
                    android:text="Usar el momento que estoy viendo" />

                <TextView
                    android:id="@+id/txtDur"
                    style="@style/Etiqueta"
                    android:text="Duración: 3 s (máx. 10)" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.5"
                    android:value="3"
                    android:valueFrom="1"
                    android:valueTo="10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearSticker"
                    style="@style/Boton"
                    android:text="Crear sticker animado" />

                <LinearLayout
                    android:id="@+id/resSticker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgSticker"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:background="#33888888"
                        android:contentDescription="Vista previa del sticker" />

                    <TextView
                        android:id="@+id/metaSticker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/sub" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStickerWhatsApp"
                        style="@style/Boton.WhatsApp"
                        android:text="Mandar sticker por WhatsApp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStickerGuardar"
                        style="@style/Boton.Borde"
                        android:text="Guardar sticker" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Los videos los genera la IA de Google. No crees videos de personas reales sin su permiso."
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
